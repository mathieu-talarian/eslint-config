{
  "name": "@mathieu-talarian/eslint-config",
  "version": "1.2.35",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublish": "yarn build",
