{
  "name": "@mathieu-talarian/eslint-config",
  "version": "1.3.26",
  "homepage": "https://github.com/mathieu-talarian/eslint-config#readme",
  "bugs": "https://github.com/mathieu-talarian/eslint-config/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathieu-talarian/eslint-config.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths && tsgo",
    "clean": "rm -rf dist",
    "prepublishOnly": "yarn build",
    "release": "npm version patch && git push --follow-tags",
    "release:major": "npm version major && npm publish",
    "release:minor": "npm version minor && npm publish"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "5.18.6",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.3",
    "@stylexjs/eslint-plugin": "0.19.0",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "10.9.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-barrel-files": "2.2.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "eslint-plugin-solid": "0.16.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-storybook": "10.5.10",
    "eslint-plugin-turbo": "2.10.12",
    "eslint-plugin-unicorn": "74.0.0",
    "eslint-plugin-vue": "10.10.0",
    "get-tsconfig": "^4.14.3",
    "globals": "17.11.0",
    "storybook": "10.5.10",
    "typescript-eslint": "8.68.0",
    "vue-eslint-parser": "10.4.1"
  },
  "devDependencies": {
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.1",
    "@tsconfig/node-lts": "24.0.1",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "26.4.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "packageManager": "yarn@4.18.0",
  "volta": {
    "node": "26.3.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
