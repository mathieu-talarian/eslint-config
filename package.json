{
  "name": "@mathieu-talarian/eslint-config",
  "version": "1.3.30",
  "homepage": "https://github.com/mathieu-talarian/eslint-config#readme",
  "bugs": "https://github.com/mathieu-talarian/eslint-config/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathieu-talarian/eslint-config.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths && tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "yarn build",
    "test:smoke": "node scripts/smoke-test.mjs",
    "release": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-barrel-files": "2.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-solid": "0.18.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-storybook": "10.6.3",
    "eslint-plugin-turbo": "2.11.10",
    "eslint-plugin-unicorn": "79.0.0",
    "eslint-plugin-vue": "10.11.1",
    "get-tsconfig": "4.14.3",
    "globals": "17.13.0",
    "storybook": "10.6.3",
    "typescript-eslint": "8.72.0",
    "vue-eslint-parser": "10.4.1"
  },
  "devDependencies": {
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.20",
    "@tsconfig/node-lts": "24.0.1",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.4.0",
    "turbo": ">2.0.0",
    "typescript": ">=5.6.3 <6.1.0"
  },
  "peerDependenciesMeta": {
    "turbo": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.18.1",
  "volta": {
    "node": "26.3.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
