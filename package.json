    "@tsconfig/node-lts": "24.0.0",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260330.1",
    "prettier": "3.8.1"
